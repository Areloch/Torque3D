
function GuiInspectorGroup::buildMenuListEntryField(%this, %fieldName, %fieldLabel, %fieldDesc, %fieldDefaultVal, %fieldDataVals, %callbackName, %ownerObj)
{
   %extent = 200;
   %inspector = %this.getParent();
   //%menuListObj = %inspector.getInspectObject();
   
   %fieldCtrl = %this.createInspectorField();
   
   %extent = %this.stack.getExtent();
   
   %width = mRound(%extent/2);
   %height = 40;
   %inset = 10;
   
   %entryIndex = getTrailingNumber(%fieldName);
   
   /*%editControl = new GuiIconButtonCtrl() {
      class = "MenuListEntryAddButton";
      HorizSizing = "left";
      VertSizing = "bottom";
      Position = %fieldCtrl.edit.position;
      Extent = "24 24";
      MinExtent = "8 2";
      canSave = "1";
      Visible = "1";
      tooltipprofile = "ToolsGuiToolTipProfile";
      Profile = "ToolsGuiButtonProfile";
      tooltip = ""; //%tooltip;
      hovertime = "1000";
      ownerObject = %ownerObj;
      fieldName = %fieldName;
      callbackName = %callbackName;
      sizeIconToButton = "0";
      bitmapAsset = "ToolsModule:iconAdd_image";
      iconLocation = "Center";
      tooltip = "Add a new menu entry to the selected MenuList to the object";
      tooltipProfile = "EditorToolTipProfile";
   };*/
   
   %templateDef = AssetDatabase.acquireAsset("UI:menuListEntryTemplate");
   
   %editControl = %templateDef.instantiate();
   %bindingListExtents = %editControl-->bindingList.extent;
   
   %editControl.setFieldBindingValue("#browseAssetButtonCommand", "AssetBrowser.showDialog(\"GUITemplateAsset\", \"AssetBrowser.changeAsset\", " @ %inspector @ ", " @ %fieldName @ ");");
   
   //get the associatedAsset
   %boundAsset = %ownerObj.getFieldValue(%fieldName);
   
   %editControl.setFieldBindingValue("#instanceTemplateAssetId", %boundAsset);
   
   if(%boundAsset !$= "")
   {
      %instanceTemplateDef = AssetDatabase.acquireAsset(%boundAsset);  

      %editControl.setFieldBindingValue("#editAssetButtonCommand", "AssetBrowser.editAsset(" @ %instanceTemplateDef @ ");");
      
      %bindableFields = %instanceTemplateDef.getFieldBindingNames(true);
      for(%fld = 0; %fld < getWordCount(%bindableFields); %fld++)
      {
         %bindableName = getWord(%bindableFields, %fld);
         
         if(startsWith(%bindableName, "#"))
            %bindableName = getSubstr(%bindableName, 1, -1);
            
         %bindingValue = %ownerObj.getFieldValue("menuListEntry" @ %entryIndex @ "_" @ %bindableName);
         
         %textBinding = new GuiControl() {
            extent = %bindingListExtents SPC 20;
            horizSizing="width";
            profile = ToolsGuiDefaultProfile;
            
            new GuiTextCtrl(){
               text = %bindableName;
               extent = %bindingListExtents/2 SPC 20;
               horizSizing="width";
               profile = ToolsGuiTextProfile;
            };
            
            new GuiTextEditCtrl() {
               class="bindingFieldTextEdit";
               position = %bindingListExtents/2 SPC 0;
               extent = %bindingListExtents/2 SPC 20;
               horizSizing="left";
               profile = ToolsGuiTextEditProfile;
               bindingFieldName = %bindableName;
               entryIndex = %entryIndex;
               menuListObj = %ownerObj;
               text = %bindingValue;
            };
         };
         
         %editControl-->bindingList.add(%textBinding);
         
         %height += 20;
      }
   }
   
   //
   %fieldCtrl.setCaption(%fieldLabel);
   %fieldCtrl.setEditControl(%editControl);
   
   %fieldCtrl.setHeightOverride(true, %height);
   
   %fieldCtrl.setCaptionPad(10);
   
   %this.addInspectorField(%fieldCtrl);
}

function bindingFieldTextEdit::onValidate( %this )
{   
   %targetObj = %this.menuListObj;
   %bindVar = "menuListEntry" @ %this.entryIndex @ "_" @ %this.bindingFieldName;
   %bindValue = %this.getText();
   %targetObj.setFieldValue(%bindVar, %bindValue);
}