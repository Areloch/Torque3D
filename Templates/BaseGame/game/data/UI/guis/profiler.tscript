function testMetrics()
{
   $testGlobalVar = 5;
   $testGlobalVar2 = 17;
   addMetric("test", "$testGlobalVar", "Test Metric:");
   addMetric("test", "$fps::real", "FPS Test:", true, "255 0 0");
   
   %out = getMetricsInGroup("test", 0);
   
   echo("input metrics data: " @ %out);
   
   showMetric("test");
}

function showMetric(%metricGroup, %forceNewLines)
{
   if(%forceNewLines $= "")
      %forceNewLines = false;
      
   %metricsData = "\"| " @ strupr(%metricGroup) @ " |\"";
   %count = getMetricsCount(%metricGroup);
   
   %graphAny = false;
   
   for(%i=0; %i < 6; %i++)
   {
      //clear prior graph plots
      MetricsGraph.removeAutoPlot(%i);  
   }
   
   MetricsGraphLegendStack.clear();
   
   if(%count > 0)
      %metricsData = %metricsData @ " NL";
      
   %plotId = 0;
   for(%i=0; %i < %count; %i++)
   {
      if(%i != 0)
      {
         if(%forceNewLines)
            %metricsData = %metricsData @ " NL ";
         else
            %metricsData = %metricsData @ " TAB ";
      }
      
      %metricsVariable = getMetricsVariable(%metricGroup, %i);
      %metricsDescription = getMetricsDescription(%metricGroup, %i);
      %metricsData = %metricsData @ "\"" @ %metricsDescription @ "\" SPC " SPC %metricsVariable;
      
      %graphingInfo = getMetricsGraphInfo(%metricGroup, %i);
      %doGraph = getField(%graphingInfo, 0);
      %graphColor = getField(%graphingInfo, 1);
      %graphInterval =  getField(%graphingInfo, 2);
      
      if(%doGraph)
      {
         %graphAny = true;
         
         MetricsGraph.addAutoPlot(%plotId, %metricsVariable, %graphInterval);
         MetricsGraph.plotColor[%plotId] = %graphColor.r SPC %graphColor.g SPC %graphColor.b SPC 255;
         %plotId++;
         
         //Now add the legend
         %swatch = new GuiSwatchButtonCtrl() {
            extent = "24 24";
            profile = "GuiDefaultProfile";
            tooltipProfile = "GuiToolTipProfile";
            color = %graphColor;
         };
         %label = new GuiTextCtrl() {
            extent = "64 24";
            profile = MenuTextEditProfile;
            tooltipProfile = "GuiToolTipProfile";
            text = %metricsDescription;
         };
         %spacer = new GuiTextCtrl() {
            extent = "24 24";
         };
            
         
         %label.extent.x = %label.profile.getStringWidth(%metricsDescription) + 5;
         if(%label.extent.x < 32)
            %label.extent.x = 32;
         
         MetricsGraphLegendStack.add(%swatch);
         MetricsGraphLegendStack.add(%label);
         MetricsGraphLegendStack.add(%spacer);
      }
   }
   
   echo("Trying metrics data:" @ %metricsData);
   $GameCanvas.pushDialog( FrameOverlayGui, 1000 );
   TextOverlayControl.setValue( %metricsData );
   
   if(%graphAny)
   {
      Canvas.pushDialog(ProfilerGui);
      ppProfilerWindow.hidden = true;
   }
   else
   {
      if(ProfilerGui.isAwake())
         Canvas.popDialog(ProfilerGui);
   }
}