<GUITemplateAsset
    AssetName="MainMenuButtonTemplate"
    VersionId="1">
    canSaveDynamicFields="true">
    <GuiButtonCtrl
        text="#Text"
        extent="400 55"
        horizSizing="width"
        profile="GuiMenuButtonProfile"
        command="#Command"
        tooltipProfile="GuiToolTipProfile"/>
</GUITemplateAsset>
