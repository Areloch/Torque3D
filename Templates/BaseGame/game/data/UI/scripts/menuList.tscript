function MenuListTemplate::onWake(%this)
{
   %this.refresh();
}

function MenuListTemplate::refresh(%this)
{
   if(!isObject(%this.instanceDataObject))
      return;
   
   if(!AssetDatabase.isDeclaredAsset(%this.instanceTemplateAsset))
      return;
      
   %this.getChildObjects()-->list.clear();
      
   %templateDef = AssetDatabase.acquireAsset(%this.instanceTemplateAsset);
   
   for(%i=0; %i < %this.instanceDataObject.count(); %i++)
   {
      %data = %this.instanceDataObject.getKey(%i);
      
      %ctrls = %templateDef.instantiate();
      
      for(%c=0; %c < getWordCount(%ctrls); %c++)
      {
         %ctrl = getWord(%ctrls, %c);
         
         %bindingsCount = getFieldCount(%data);
         for(%f=0; %f < %bindingsCount; %f++)
         {
            %bindingData = getField(%data, %f);
            
            %bindingName = getToken(%bindingData, "=", 0);
            %bindingValue = getToken(%bindingData, "=", 1);
            //now do the binding work
            %ctrl.setFieldBindingValue(%bindingName, %bindingValue, true);
         }
         
         %listCtrl = %this.getChildObjects()-->list;
         %listWidth = %listCtrl.extent.x;
         %ctrl.setExtent(%listWidth, %ctrl.extent.y);
         %this.getChildObjects()-->list.add(%ctrl);
      }
   }
   
   AssetDatabase.releaseAsset(%this.instanceTemplateAsset);
}

