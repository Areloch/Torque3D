function MenuListTemplate::addNewFieldEntry(%this, %inspectorGroup)
{
   %inspectorGroup.addField("menuListEntry" @ %this.entryListCount @ "", "menuListEntry" /*"menuListEntry"*/, "", "");
   %this.entryListCount++;
}

function GuiEditorInspectFields::setMenuListInstanceTemplateAsset(%this, %variable, %data, %obj)
{
   %obj.refresh();
}

function GuiEditorInspectFields::setMenuListInstanceDataObject(%this, %variable, %data,  %obj)
{
   %obj.refresh();
}