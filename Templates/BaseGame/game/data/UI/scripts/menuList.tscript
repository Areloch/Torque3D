function MenuListTemplate::onWake(%this)
{
   %this.refresh();
}

function MenuListTemplate::refresh(%this)
{
   %listCtrl = %this.getChildObjects()-->list;
   %listCtrl.clear();
   
   for(%i=0; %i < %this.entryListCount; %i++)
   {
      %entryVar = "menuListEntry" @ %i;
      %entryTemplateAsset = %this.getFieldValue(%entryVar);
      
      %templateDef = AssetDatabase.acquireAsset(%entryTemplateAsset);
      %ctrls = %templateDef.instantiate();
      AssetDatabase.releaseAsset(%entryTemplateAsset);
      
      %listWidth = %listCtrl.extent.x;
      
      for(%c=0; %c < getWordCount(%ctrls); %c++)
      {
         %entryCtrl = getWord(%ctrls, %c);
      
         %bindingsList = %entryCtrl.getFieldBindingNames();
         for(%f=0; %f < getWordCount(%bindingsList); %f++)
         {
            %bindingName = getWord(%bindingsList, %f);
            
            if(startsWith(%bindingName, "#"))
            {
               %bindingName = getSubStr(%bindingName, 1, -1); 
            }
    
            %bindingInstanceVar = "menuListEntry" @ %i @ "_" @ %bindingName;
            
            %bindingInstanceValue = %this.getFieldValue(%bindingInstanceVar);
            
            %entryCtrl.setFieldBindingValue("#" @ %bindingName, %bindingInstanceValue);
         }

         %entryCtrl.extent.x = %listWidth;
         //.setExtent(%listWidth, %entryCtrl.extent.y);
         %listCtrl.add(%entryCtrl);
      }
   }
   
   %listCtrl.updateStack();
}