function AssetBrowser::createGUITemplateAsset(%this)
{
   %objCount = GuiEditor.newTemplateTargetObjs.getCount();
   if(%objCount == 0)
   {
      error("AssetBrowser::createGUITemplateAsset() - invalid newTemplateTargetObj! Cannot make new GUITemplateAsset");
      return "";
   }
   
   %moduleName = AssetBrowser.newAssetSettings.moduleName;
   %modulePath = "data/" @ %moduleName;
      
   %assetName = AssetBrowser.newAssetSettings.assetName;
   
   %assetPath = NewAssetTargetAddress.getText() @ "/";
   
   %tamlpath = %assetPath @ %assetName @ ".asset.taml";
   
   %asset = new GUITemplateAsset()
   {
      AssetName = %assetName;
      versionId = 1;
   };
   
   //Now, we create a container ctrl and add our selection to it
   %container = new GuiControl()
   {
      class=%assetName;
   };
   
   %minPosition = Canvas.getExtent();
   %maxExtent = "0 0";
   for(%i=0; %i < %objCount; %i++)
   {
      %obj = GuiEditor.newTemplateTargetObjs.getObject(%i);
      if(%obj.position.x < %minPosition.x)
         %minPosition.x = %obj.position.x;
      if(%obj.position.y < %minPosition.y)
         %minPosition.y = %obj.position.y;
         
      if(%obj.extent.x > %maxExtent.x)
         %maxExtent.x = %obj.extent.x;
      if(%obj.extent.y > %maxExtent.y)
         %maxExtent.y = %obj.extent.y;
         
      %container.add(%obj);
   }
   
   //now we offset the difference to make everything fit to the
   //new container root
   for(%i=0; %i < %objCount; %i++)
   {
      %obj = GuiEditor.newTemplateTargetObjs.getObject(%i);
    
      %obj.setPosition(%obj.position.x - %minPosition.x, %obj.position.y - %minPosition.y);  
   }
   
   %container.extent = %maxExtent;
   
   %asset.add(%container.deepClone());
   
   TamlWrite(%asset, %tamlpath);
	
	%moduleDef = ModuleDatabase.findModule(%moduleName, 1);
	AssetDatabase.addDeclaredAsset(%moduleDef, %tamlpath);

	AssetBrowser.refresh();
	
	return %tamlpath;  
}

function AssetBrowser::inspectImportingGUITemplateAsset(%this, %assetItem)
{
}

function AssetBrowser::editGUITemplateAsset(%this, %assetDef)
{
   if( EditorIsActive() && !GuiEditor.toggleIntoEditorGui )
         toggleEditor( true );
         
   if( !$InGuiEditor && !GuiEditorIsActive() )
      GuiEditor.open();
      
   GuiEditor.editAsset = %assetDef;
   GuiEditor.editTemplateCtrl = %assetDef.instantiate();
   GuiEditor.editTemplateCtrl.setName(%assetDef.assetName);
      
   GuiEditContent(GuiEditor.editTemplateCtrl);  
}

//Renames the asset
function AssetBrowser::renameGUITemplateAsset(%this, %assetDef, %newAssetName)
{
   %assetDef.saveAsset();
   
   renameAssetFile(%assetDef, %newAssetName);
}

//Deletes the asset
function AssetBrowser::deleteGUITemplateAsset(%this, %assetDef)
{
   AssetDatabase.deleteAsset(%assetDef.getAssetId(), true);
}

//Moves the asset to a new path/module
function AssetBrowser::moveGUITemplateAsset(%this, %assetDef, %destination)
{
   %currentModule = AssetDatabase.getAssetModule(%assetDef.getAssetId());
   %targetModule = AssetBrowser.dirHandler.getModuleFromAddress(%destination);
   
   %newAssetPath = moveAssetFile(%assetDef, %destination);
   
   if(%newAssetPath $= "")
      return false;
   
   AssetDatabase.removeDeclaredAsset(%assetDef.getAssetId());
   AssetDatabase.addDeclaredAsset(%targetModule, %newAssetPath);
}


function AssetBrowser::buildGUITemplateAssetPreview(%this, %assetDef, %previewData)
{
   %previewData.assetName = %assetDef.assetName;
   %previewData.assetPath = makeFullPath(%assetDef.getFilename());
   %previewData.doubleClickCommand = "";
   
   %previewData.previewImage = "ToolsModule:guiIcon_image";
   
   %previewData.assetFriendlyName = %assetDef.assetName;
   %previewData.assetDesc = %assetDef.description;
   %previewData.tooltip = "Asset Name: " @ %assetDef.assetName;
}

function AssetBrowser::onGUITemplateAssetGUIEditorDropped(%this, %assetDef, %position)
{
   %extents = %assetDef.getExtents();
   
   %ctrl = new GuiTemplateCtrl()
   {
      position = %position;
      extent = %extents;
      templateAsset = %assetDef.getAssetId();
   };
   
   GuiEditor.getContentControl().add(%ctrl);
      
   GuiEditor.clearSelection();
   GuiEditor.schedule(32, "addSelection", %ctrl );
}