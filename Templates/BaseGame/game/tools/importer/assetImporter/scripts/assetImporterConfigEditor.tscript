function AssetImporterConfigEditor::onWake()
{
   AssetImporterConfigEditor::refresh();
}

function AssetImporterConfigEditor::refresh()
{
   AICE_ConfigsList.populate();
   
   AICE_TasksList.clear();
   AICE_NewTasksContainer.setHidden(true);
}

function AssetImporterConfigEditor::open()
{
   Canvas.pushDialog(AssetImporterConfigEditor);  
}

function AssetImporterConfigEditor::close()
{
   Canvas.popDialog(AssetImporterConfigEditor);  
}

//
//
//
function AICE_ConfigsList::populate(%this)
{
   %this.clear();
   %this.addRow(%this.rowCount(), "Default Import Config");
}

function AICE_ConfigsList::onSelect(%this, %id, %text)
{
   //load the particular config here
   
   if(!isObject(AssetImporterConfigEditor.currentConfig))
   {
      AssetImporterConfigEditor.currentConfig = new SimGroup()
      {
         internalName = %text;      
      };
      
      for(%i=0; %i < AssetImporterAssetTypes.count(); %i++)
      {
         %assetType = AssetImporterAssetTypes.getKey(%i); 
         
         %assetTypeGroup = new SimGroup()
         {
            internalName = %assetType;      
         };
         
         AssetImporterConfigEditor.currentConfig.add(%assetTypeGroup);
      }
   }
   
   AICE_TasksList.populate();
}

//
//
//
function AICE_TasksList::populate(%this)
{
   %this.clear();
   
   for(%i=0; %i < AssetImporterConfigEditor.currentConfig.getCount(); %i++)
   {
      %assetTypeGroup = AssetImporterConfigEditor.currentConfig.getObject(%i);
      %assetType = %assetTypeGroup.internalName;
      
      %assetRoll = new GuiRolloutCtrl() { 
         caption = %assetType @ "s";
         extent = MainViewStack.extent.x SPC 40;
         profile = GuiInspectorGroupProfile;
         margin = "5 5 5 5";
      
         new GuiStackControl() {
            internalName = %assetType @ "Stack";
            assetTypeGroup = %assetTypeGroup;
            padding = "5";
         
            new GuiIconButtonCtrl() {
               BitmapAsset = "ToolsModule:iconAdd_image";
               textLocation = "Right";
               text = "Add Task";
               profile = "ToolsGuiIconButtonProfile";
               tooltipProfile = "GuiToolTipProfile";
               command = "AssetImporterConfigEditor.showAddNewTaskPanel(" @ %assetTypeGroup @ ");";
            };
         };
      };
      
      for(%t = 0; %t < %assetTypeGroup.getCount(); %t++)
      {
         %task = %assetTypeGroup.getObject(%t);
         
         %card = AssetImporterConfigEditor::createAddTaskCard(%task, AssetImporterConfigEditor @ ".editTask(" @ %task @ ");");

         %assetRoll.findObjectByInternalName(%assetType @ "Stack").add(%card);
      }
      
      %this.add(%assetRoll);
   }
}

function AssetImporterConfigEditor::showAddNewTaskPanel(%this, %assetTypeGroup)
{
   AICE_PropertiesContainer.setHidden(true);
   AICE_NewTasksContainer.setHidden(false);
   AICE_NewTasksList.clear();
   
   for(%i=0; %i < AssetImporterRegisteredTasks.count(); %i++)
   {
      %task = AssetImporterRegisteredTasks.getKey(%i);
      if(%task.type $= %assetTypeGroup.internalName || %task.type $= "any" || %task.type $= "")
      {
         %card = AssetImporterConfigEditor::createAddTaskCard(%task, %this @ ".addNewTask($ThisControl, " @ %assetTypeGroup @ ");");
         AICE_NewTasksList.add(%card);
      }
   }
}

function AssetImporterConfigEditor::addNewTask(%this, %taskEntry, %assetTypeGroup)
{
   %taskCopy = %taskEntry.getParent().taskObject.clone();
   %taskCopy.setName("");
   %taskCopy.superClass = %taskEntry.getParent().taskObject.getName();
   %assetTypeGroup.add(%taskCopy);
   
   AICE_NewTasksContainer.setHidden(true);
   AICE_PropertiesContainer.setHidden(false);
   
   AssetImporterConfigEditor::refresh();
}

function AssetImporterConfigEditor::editTask(%this, %taskObject)
{
   AICE_NewTasksContainer.setHidden(true);
   AICE_PropertiesContainer.setHidden(false);
   //%this.clearTaskSelection();
   //%taskCtrl.setHighlighted(true);
   %taskObject.populateFields();  
}

