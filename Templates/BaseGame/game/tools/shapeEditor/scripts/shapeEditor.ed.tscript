//
//
//
//
function ShapeEditorPlugin::openShapeEditor(%this, %assetId)
{
   exec("tools/shapeEditor/gui/shapeEditor.ed.gui");
   EditorGuiMainTabBook.add($guiContent);
   
   %shapeEdSession = new ScriptObject(){
      class = "ShapeEditor";
      shape = -1;
      deletedCount = 0;
      tabName = "ShapeEditor_" @ strReplace(%assetId, ":", "_");
      editorPage = $guiContent;
      editedAssetId = %assetId;
   };
   
   $guiContent.shapeEditor = %shapeEdSession;
   
   $guiContent.text = %assetId;
   $guiContent.internalName = %shapeEdSession.tabName;
   
   $guiContent-->FrameSet.columns = 0 SPC $guiContent.extent.x * 0.20 SPC $guiContent.extent.x * 0.80;
   $guiContent-->FrameSet.updateSizes();
   
   $ActiveShapeView = $guiContent-->ShapeView;
   $ActiveShapeEditor = %shapeEdSession;

   //Load our scene
   exec("tools/levels/ShapePreviewScene.mis");
   
   $ActiveShapeEditor.previewScene = getScene(getSceneCount()-1);
   
   %shape = new TSStatic() {
      shapeAsset = $ActiveShapeEditor.editedAssetId;
   };
   $ActiveShapeEditor.previewScene.add(%shape);
   
   $ActiveShapeEditor.editorPage-->ShapeView.setModel(%shape);
   
   $ActiveShapeEditor.editorPage-->ShapeView.schedule(32, "fitToShape");

   ShapeEdUndoManager.clearAll();
   $ActiveShapeEditor.setDirty( false );

   // Get ( or create ) the TSShapeConstructor object for this shape
   $ActiveShapeEditor.shapeConstructor = findShapeConstructorByAssetId( $ActiveShapeEditor.editedAssetId );
   if ( $ActiveShapeEditor.shapeConstructor <= 0 )
   {
      $ActiveShapeEditor.shapeConstructor = $ActiveShapeEditor.createConstructor( $ActiveShapeEditor.editedAssetId );
      if ( $ActiveShapeEditor.shapeConstructor <= 0 )
      {
         error( "ShapeEditor: Error - could not select " @ $ActiveShapeEditor.editedAssetId );
         return;
      }
   }

   // Initialise the editor windows
   $ActiveShapeEditor.editorPage-->ShapeEdAdvancedWindow.update_onShapeSelectionChanged();
   $ActiveShapeEditor.editorPage-->ShapeEdMountWindow.update_onShapeSelectionChanged();
   $ActiveShapeEditor.editorPage-->ShapeEdThreadWindow.update_onShapeSelectionChanged();
   $ActiveShapeEditor.editorPage-->ShapeEdColWindow.update_onShapeSelectionChanged();
   $ActiveShapeEditor.editorPage-->ContentsWindow.update_onShapeSelectionChanged();
   $ActiveShapeEditor.editorPage-->ShapeView.refreshShape();

   // Update object type hints
   $ActiveShapeEditor.editorPage-->ShapeEdSelectWindow.updateHints();

   // Update editor status bar
   EditorGuiStatusBar.setSelection( $ActiveShapeEditor.editedAssetId ); 
}

//Swapping on/off from a ShapeEditor Instance
function ShapeEditorTabPage::onTabSelected(%this)
{
   getRootScene().callOnChildren("setHidden", true);
   
   //Swap to this as our active shapeEditor
   $ActiveShapeEditor = %this.shapeEditor;

   $ActiveShapeEditor.previewScene.callOnChildren("setHidden", false);
}

function ShapeEditorTabPage::onTabUnselected(%this)
{
   //hide everything in the subscene
   $ActiveShapeEditor.previewScene.callOnChildren("setHidden", true);
   
   //clear active editor
   $ActiveShapeEditor = 0;
   
   getRootScene().callOnChildren("setHidden", false);
}

//==============================================================================
// ShapeConstructor handling
//==============================================================================
function ShapeEditor::findConstructor( %this, %path )
{
   if (!isObject(TSShapeConstructorGroup))
      return -1;

   %count = TSShapeConstructorGroup.getCount();
   for ( %i = 0; %i < %count; %i++ )
   {
      %obj = TSShapeConstructorGroup.getObject( %i );
      if ( %obj.baseShape $= %path )
         return %obj;
   }
   return -1;
}

function ShapeEditor::createConstructor( %this, %assetId )
{
   %name = AssetDatabase.getAssetName(%assetId);
   //%name = strcapitalise( fileBase( %path ) ) @ strcapitalise( getSubStr( fileExt( %path ), 1, 3 ) );
   //%name = strreplace( %name, "-", "_" );
   //%name = strreplace( %name, ".", "_" );
   %name = getUniqueName( %name );
   return new TSShapeConstructor( %name ) { baseShapeAsset = %assetId; };
}

function ShapeEditor::saveConstructor( %this, %constructor )
{
   %assetDef = AssetDatabase.acquireAsset(%constructor.baseShapeAsset);
   %savepath = %assetDef.getShapeConstructorFilePath();
   AssetDatabase.releaseAsset(%constructor.baseShapeAsset);
   
   new PersistenceManager( shapeEd_perMan );
   shapeEd_perMan.setDirty( %constructor, %savepath );
   shapeEd_perMan.saveDirtyObject( %constructor );
   shapeEd_perMan.delete();
}

//
//
//
function ShapeEdContentsTabBook::onTabSelected(%this, %text, %id)
{
   %page = %this.getObject(%id);
   if(%page.isMethod("onTabSelected"))
      %page.onTabSelected();
}

function ShapeEdContentsTabBook::onTabUnSelected(%this, %text, %id)
{
   %page = %this.getObject(%id);
   if(%page.isMethod("onTabUnSelected"))
      %page.onTabUnSelected();
}

//==============================================================================
// Materials Content
//==============================================================================
function ShapeEdMaterialsTab::onTabSelected(%this)
{
   $ActiveShapeEditor.editorPage-->shapeEdPropertiesInspector.clearFields();
   %this.updateMaterialList();
}

function ShapeEdMaterialsTab::updateMaterialList( %this )
{
   // --- MATERIALS TAB ---
   %this-->ShapeEdMaterialList.clear();
   %this-->ShapeEdMaterialList.addRow( -2, "Name" TAB "Mapped" );
   %this-->ShapeEdMaterialList.setRowActive( -2, false );
   %this-->ShapeEdMaterialList.addRow( -1, "<none>" );
   
   %count = $ActiveShapeEditor.shapeConstructor.getTargetCount();
   for ( %i = 0; %i < %count; %i++ )
   {
      %matName = $ActiveShapeEditor.shapeConstructor.getTargetName( %i );
      %mapped = getMaterialMapping( %matName );
      if ( %mapped $= "" )
         %this-->ShapeEdMaterialList.addRow( WarningMaterial.getID(), %matName TAB "unmapped" );
      else
         %this-->ShapeEdMaterialList.addRow( %mapped.getID(), %matName TAB %mapped );
   }

   %this-->materialListHeader.setExtent( getWord( %this-->ShapeEdMaterialList.extent, 0 ) SPC "19" );
}

