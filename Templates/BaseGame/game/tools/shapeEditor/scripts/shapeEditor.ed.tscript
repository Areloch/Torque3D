function ShapeEdMaterialList::onSelect(%this, %cellid, %text)
{
   %editorPage = $ActiveShapeEditor.editorPage;
   
   $ActiveShapeEditor.selectedMaterial = %text;
   
   //(const char* name, const char* label, const char* typeName, const char* description, const char* defaultValue, const char* dataValues, SimObject* ownerObj)
   %editorPage-->shapeEdPropertiesInspector.clearFields();
   
   %editorPage-->shapeEdPropertiesInspector.startGroup("Materials");
   %editorPage-->shapeEdPropertiesInspector.addField("Edit", "Edit This Material", "button", "Opens the selected material in the Material Editor", "", %editorPage @ "-->ShapeEdMaterialsTab.editSelectedMaterial();");
   
   //ShapeEdMaterials.updateSelectedMaterial($ThisControl.getValue());
   %editorPage-->shapeEdPropertiesInspector.addField("ToggleMaterialHighlight", "Toggle Material Highlighting", "bool", "Highlight the primitives that use the selected Material");
   %editorPage-->shapeEdPropertiesInspector.endGroup();
}

//==============================================================================
// Details Content
//==============================================================================

function ShapeEdDetailsTab::onTabSelected(%this)
{
   $ActiveShapeEditor.editorPage-->shapeEdPropertiesInspector.clearFields();
   %this.updateDetailsList();
   
   $ActiveShapeEditor.editorPage-->ShapeEdDetailTree.onDefineIcons();
}

function ShapeEdDetailsTab::updateDetailsList( %this )
{
   // Add detail levels and meshes to tree
   %this-->ShapeEdDetailTree.clearSelection();
   %this-->ShapeEdDetailTree.removeItem( 0 );
   %root = %this-->ShapeEdDetailTree.insertItem( 0, "<root>", "", "" );
   %objCount = $ActiveShapeEditor.shapeConstructor.getObjectCount();
   for ( %i = 0; %i < %objCount; %i++ )
   {
      %objName = $ActiveShapeEditor.shapeConstructor.getObjectName( %i );
      %meshCount = $ActiveShapeEditor.shapeConstructor.getMeshCount( %objName );
      for ( %j = 0; %j < %meshCount; %j++ )
      {
         %meshName = $ActiveShapeEditor.shapeConstructor.getMeshName( %objName, %j );
         %this-->ShapeEdDetailTree.addMeshEntry( %meshName, 1 );
      }
   }
}

function ShapeEdDetailTree::addMeshEntry( %this, %name, %noSync )
{
   // Add new detail level if required
   %size = getTrailingNumber( %name );
   %detailID = %this.findItemByValue( %size );
   if ( %detailID <= 0 )
   {
      %dl = $ActiveShapeEditor.shapeConstructor.getDetailLevelIndex( %size );
      %detName = $ActiveShapeEditor.shapeConstructor.getDetailLevelName( %dl );
      %detailID = %this-->ShapeEdDetailTree.insertItem( 1, %detName, %size, "" );

      // Sort details by decreasing size
      for ( %sibling = %this-->ShapeEdDetailTree.getPrevSibling( %detailID );
            ( %sibling > 0 ) && ( %this-->ShapeEdDetailTree.getItemValue( %sibling ) < %size );
            %sibling = %this-->ShapeEdDetailTree.getPrevSibling( %detailID ) )
         %this-->ShapeEdDetailTree.moveItemUp( %detailID );

      if ( !%noSync )
        $ActiveShapeEditor.editorPage-->ShapeEdDetailsTab.update_onDetailsChanged();
   }
   return %this.insertItem( %detailID, %name, "", "" );
}

function ShapeEdDetailTree::removeMeshEntry( %this, %name, %size )
{
   %size = getTrailingNumber( %name );
   %id = %this-->ShapeEdDetailTree.findItemByName( %name );
   if ( $ActiveShapeEditor.shapeConstructor.getDetailLevelIndex( %size ) < 0 )
   {
      // Last mesh of a detail level has been removed => remove the detail level
      %this.removeItem( %this.getParentItem( %id ) );
      $ActiveShapeEditor.editorPage-->ShapeEdDetailsTab.update_onDetailsChanged();
   }
   else
      %this.removeItem( %id );
}

function ShapeEdDetailTree::onSelect( %this, %id )
{
   %editorPage = $ActiveShapeEditor.editorPage;
   %inspector = %editorPage-->shapeEdPropertiesInspector;
   
   $ActiveShapeEditor.selectedDetail = %id;
   
   %name = %this.getItemText( %id );
   %baseName = stripTrailingNumber( %name );
   %size = getTrailingNumber( %name );
   
   //(const char* name, const char* label, const char* typeName, const char* description, const char* defaultValue, const char* dataValues, SimObject* ownerObj)
   %inspector.clearFields();
   
   %inspector.startGroup("Detail Properties");
   %inspector.addCallbackField("MeshName", "Mesh Name", "String", "Name of the Detail Mesh", %baseName, "", "renameMesh");
   %inspector.addField("MeshSize", "Mesh Size", "String", "Size in pixels the Detail Mesh is targeting", %size, "");
   %inspector.addField("BillboardType", "Billboard Type", "list", "The type of billboarding to use on the current detail mesh", "", "Blbrds");
   %inspector.addField("ObjectNode", "Object Node", "list", "The node that the current detail level is targeting", "", "Mesh");
   %inspector.endGroup();
   
   %inspector.startGroup("Bounds");
   %inspector.addField("Recompute", "Recompute Bounds", "button", "Recomputes the bounds of the selected Detail Mesh", "", "");
   %inspector.endGroup();
   
   %inspector.startGroup("Billboard Impostors");
   %inspector.addField("UseImpostors", "Use Impostors", "bool", "Does this mesh generate and utilize billboard impostors", "", "");
   /*
   %editorPage-->shapeEdPropertiesInspector.addField("ImpostorDetailSize", "Impostor Detail Size", "String", "Size in pixels the Impostors are targeting", "1", "");
   %editorPage-->shapeEdPropertiesInspector.addField("ImpostorResolution", "Impostor Resolution", "String", "Resolution of the images generate for Impostors", "128", "");
   %editorPage-->shapeEdPropertiesInspector.addField("ImpostorXSteps", "X Axis Steps", "String", "Number of steps around the X axis to capture for the Impostors", "6", "");
   %editorPage-->shapeEdPropertiesInspector.addField("ImpostorUsePoles", "Capture Poles", "bool", "Do the impostors also capture the poles angles of the mesh", "", "");
   %editorPage-->shapeEdPropertiesInspector.addField("ImpostorYSteps", "Y Axis Steps", "String", "Number of steps around the X axis to capture for the Impostors", "6", "");
   %editorPage-->shapeEdPropertiesInspector.addField("ImpostorYAngle", "Y Axis Angle", "String", "Angle to capture along the Y axis for the Impostors", "30", "");*/
   %inspector.endGroup();

   // Select the appropriate detail level
   %dl = %this.getDetailLevelFromItem( %id );
   $ActiveShapeEditor.editorPage-->ShapeView.currentDL = %dl;

   if ( %this.isDetailItem( %id ) )
   {
      // Selected a detail => disable mesh controls
      $ActiveShapeEditor.editorPage-->ShapeEdDetails-->editMeshInactive.setVisible( true );
      $ActiveShapeEditor.editorPage-->ShapeView.selectedObject = -1;
      $ActiveShapeEditor.editorPage-->ShapeView.selectedObjDetail = 0;
   }
   else
   {
      // Selected a mesh => sync mesh controls
      $ActiveShapeEditor.editorPage-->ShapeEdDetails-->editMeshInactive.setVisible( false );

      switch$ ( $ActiveShapeEditor.shapeConstructor.getMeshType( %name ) )
      {
         case "normal":          $ActiveShapeEditor.editorPage-->ShapeEdDetails-->bbType.setSelected( 0, false );
         case "billboard":       $ActiveShapeEditor.editorPage-->ShapeEdDetails-->bbType.setSelected( 1, false );
         case "billboardzaxis":  $ActiveShapeEditor.editorPage-->ShapeEdDetails-->bbType.setSelected( 2, false );
      }

      %node = $ActiveShapeEditor.shapeConstructor.getObjectNode( %baseName );
      if ( %node $= "" )
         %node = "<root>";
      $ActiveShapeEditor.editorPage-->ShapeEdDetails-->objectNode.setSelected( $ActiveShapeEditor.editorPage-->ShapeEdDetails-->objectNode.findText( %node ), false );
      $ActiveShapeEditor.editorPage-->ShapeView.selectedObject = $ActiveShapeEditor.shape.getObjectIndex( %baseName );
      $ActiveShapeEditor.editorPage-->ShapeView.selectedObjDetail = %dl;
   }
}

function ShapeEdMaterialList::onSelect(%this, %cellid, %text)
{
   %editorPage = $ActiveShapeEditor.editorPage;
   
   $ActiveShapeEditor.selectedMaterial = %text;
   
   //(const char* name, const char* label, const char* typeName, const char* description, const char* defaultValue, const char* dataValues, SimObject* ownerObj)
   %editorPage-->shapeEdPropertiesInspector.clearFields();
   
   %editorPage-->shapeEdPropertiesInspector.startGroup("Materials");
   %editorPage-->shapeEdPropertiesInspector.addField("Edit", "Edit This Material", "button", "Opens the selected material in the Material Editor", "", %editorPage @ "-->ShapeEdMaterialsTab.editSelectedMaterial();");
   
   //ShapeEdMaterials.updateSelectedMaterial($ThisControl.getValue());
   %editorPage-->shapeEdPropertiesInspector.addField("ToggleMaterialHighlight", "Toggle Material Highlighting", "bool", "Highlight the primitives that use the selected Material");
   %editorPage-->shapeEdPropertiesInspector.endGroup();
}

function ShapeEdDetailTree::onDefineIcons(%this)
{
   // Set the tree view icon indices and texture paths
   %this._imageNone = 0;
   %this._imageHidden = 1;

   %icons = ":" @                                        // no icon
            "tools/gui/images/visible_i:";               // hidden

   %this.buildIconTable( %icons );
}

//==============================================================================
// ShapeEditor Properties Inspector callbacks
//==============================================================================
function ShapeEdPropertiesInspector::renameMesh(%this, %variableName, %newData, %targetObject)
{
   error("ShapeEdPropertiesInspector::renameMesh() - called on: " @ %variableName @ ": " @ %newData @ " for object: " @ %targetObject);
}