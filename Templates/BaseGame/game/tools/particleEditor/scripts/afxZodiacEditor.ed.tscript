//=============================================================================================
//    PE_AFXZodiacEditor.
//=============================================================================================
function PE_AFXZodiacEditor::openEditorTab(%this)
{
   PE_Window.text = ":: Particle Editor - AFX Zodiacs";
   %this.guiSync();
   ParticleEditor.activeEditor = %this;

   if( !%this.dirty )
      %this.setNotDirty();
}

//---------------------------------------------------------------------------------------------

function PE_AFXZodiacEditor::guiSync( %this )
{
   %this.createList();
   
   %this-->inspector.refresh();
}

//------------------------------------------------------------------------------

function PE_AFXZodiacEditor::selectedObject(%this, %obj)
{
   %this-->popupMenu.setText(%obj.getName());
   %this-->inspector.inspect(%obj);
   
   %this.currEmitter = %obj;
   
   %this.guiSync();
   
   ParticleEditor.updateEmitterNode();
}

//---------------------------------------------------------------------------------------------

// Generic updateEmitter method
function PE_AFXZodiacEditor::updateEmitter( %this, %propertyField, %value, %isSlider, %onMouseUp )
{
   PE_AFXZodiacEditor.setDirty();
         
   %emitter = PE_AFXZodiacEditor.currEmitter;
      
   %last = Editor.getUndoManager().getUndoAction(Editor.getUndoManager().getUndoCount() - 1);
   if( (%isSlider) && (%last.isSlider) && (!%last.onMouseUp) )
   {
      %last.field = %propertyField;
      %last.isSlider = %isSlider;
      %last.onMouseUp = %onMouseUp;
      %last.newValue = %value;
   }
   else
   {
      %action = ParticleEditor.createUndo(ActionUpdateActiveEmitter, "Update Active Emitter");
      %action.emitter = %emitter;
      %action.field = %propertyField;
      %action.isSlider = %isSlider;
      %action.onMouseUp = %onMouseUp;
      %action.newValue = %value;
      %action.oldValue = %emitter.getFieldValue( %propertyField );
      
      ParticleEditor.submitUndo( %action );
   }
   	
	%emitter.setFieldValue( %propertyField, %value );
	%emitter.reload();
}

//---------------------------------------------------------------------------------------------

// Special case updateEmitter methods
function PE_AFXZodiacEditor::updateLifeFields( %this, %isRandom, %value, %isSlider, %onMouseUp )
{
   PE_AFXZodiacEditor.setDirty();
   
   %emitter = PE_AFXZodiacEditor.currEmitter;
      
   // Transfer values over to gui controls.
   
   if( %isRandom )
   {
      if( %value > 0 )
         %value++;
          
      if( %value > PE_AFXZodiacEditor-->PEE_lifetimeMS_slider.getValue() )
      {
         PE_AFXZodiacEditor-->PEE_lifetimeMS_textEdit.setText( %value );
         PE_AFXZodiacEditor-->PEE_lifetimeMS_slider.setValue( %value );
      }
   }
   else
   {
      if( %value > 0 )
         %value --;
         
      if( %value < PE_AFXZodiacEditor-->PEE_lifetimeVarianceMS_slider.getValue() )
      {
         PE_AFXZodiacEditor-->PEE_lifetimeVarianceMS_textEdit.setText( %value );
         PE_AFXZodiacEditor-->PEE_lifetimeVarianceMS_slider.setValue( %value );
      }
   }
   
   // Submit undo.
   
   %last = Editor.getUndoManager().getUndoAction(Editor.getUndoManager().getUndoCount() - 1);
   if( (%isSlider) && (%last.isSlider) && (!%last.onMouseUp) )
   {
      %last.isSlider = %isSlider;
      %last.onMouseUp = %onMouseUp;
      %last.newValueLifetimeMS = PE_AFXZodiacEditor-->PEE_lifetimeMS_textEdit.getText();
      %last.newValueLifetimeVarianceMS = PE_AFXZodiacEditor-->PEE_lifetimeVarianceMS_textEdit.getText();
   }
   else
   {
      %action = ParticleEditor.createUndo(ActionUpdateActiveEmitterLifeFields, "Update Active Emitter");
      %action.emitter = %emitter;
      %action.isSlider = %isSlider;
      %action.onMouseUp = %onMouseUp;
      
      %action.newValueLifetimeMS = PE_AFXZodiacEditor-->PEE_lifetimeMS_textEdit.getText();
      %action.oldValueLifetimeMS = %emitter.lifetimeMS;
      
      %action.newValueLifetimeVarianceMS = PE_AFXZodiacEditor-->PEE_lifetimeVarianceMS_textEdit.getText();
      %action.oldValueLifetimeVarianceMS = %emitter.lifetimeVarianceMS;
      
      ParticleEditor.submitUndo( %action );
   }
   
   // Set the values on the current emitter.
   
   %emitter.lifetimeMS = PE_AFXZodiacEditor-->PEE_lifetimeMS_textEdit.getText();
   %emitter.lifetimeVarianceMS = PE_AFXZodiacEditor-->PEE_lifetimeVarianceMS_textEdit.getText();
   %emitter.reload();
   
   // Keep the infiniteLoop checkbox up to date.
   
   PE_AFXZodiacEditor-->PEE_infiniteLoop.setStateOn(
      %emitter.lifetimeMS == 0
   );
}

//---------------------------------------------------------------------------------------------

function PE_AFXZodiacEditor::updateLifeFieldsInfiniteLoop( %this )
{
   %emitter = PE_AFXZodiacEditor.currEmitter;
   %isEnabled = PE_AFXZodiacEditor-->PEE_infiniteLoop.isStateOn();
      
   // Submit undo.
   
   %action = ParticleEditor.createUndo( ActionUpdateActiveEmitterLifeFields, "Update Active Emitter" );
   %action.emitter = %emitter;
   
   if( %isEnabled )
   {
      %action.newValueLifetimeMS = 0;
      %action.newvalueLifetimeVarianceMS = 0;
      %action.oldValueLifetimeMS = PE_AFXZodiacEditor-->PEE_lifetimeMS_textEdit.getText();
      %action.oldValueLifetimeVarianceMS = PE_AFXZodiacEditor-->PEE_lifetimeVarianceMS_textEdit.getText();
   }
   else
   {
      %action.newValueLifetimeMS = PE_AFXZodiacEditor-->PEE_lifetimeMS_textEdit.getText();
      %action.newvalueLifetimeVarianceMS = PE_AFXZodiacEditor-->PEE_lifetimeVarianceMS_textEdit.getText();
      %action.oldValueLifetimeMS = 0;
      %action.oldValueLifetimeVarianceMS = 0;
   }
            
   ParticleEditor.submitUndo( %action );
   
   // Execute action.
   
   %action.redo();
}

//---------------------------------------------------------------------------------------------

function PE_AFXZodiacEditor::updateAmountFields( %this, %isRandom, %value, %isSlider, %onMouseUp )
{
   PE_AFXZodiacEditor.setDirty();
   %emitter = PE_AFXZodiacEditor.currEmitter;
      
   // Transfer values over to gui controls.
   
   if( %isRandom )
   {
      %value ++;
      if( %value > PE_AFXZodiacEditor-->PEE_ejectionPeriodMS_slider.getValue() )
      {
         PE_AFXZodiacEditor-->PEE_ejectionPeriodMS_textEdit.setText( %value );
         PE_AFXZodiacEditor-->PEE_ejectionPeriodMS_slider.setValue( %value );
      }
   }
   else
   {
      %value --;
      if( %value < PE_AFXZodiacEditor-->PEE_periodVarianceMS_slider.getValue() )
      {
         PE_AFXZodiacEditor-->PEE_periodVarianceMS_textEdit.setText( %value );
         PE_AFXZodiacEditor-->PEE_periodVarianceMS_slider.setValue( %value );
      }
   }
   
   // Submit undo.
   
   %last = Editor.getUndoManager().getUndoAction(Editor.getUndoManager().getUndoCount() - 1);
   if( (%isSlider) && (%last.isSlider) && (!%last.onMouseUp) )
   {
      %last.isSlider = %isSlider;
      %last.onMouseUp = %onMouseUp;
      %last.newValueEjectionPeriodMS = PE_AFXZodiacEditor-->PEE_ejectionPeriodMS_textEdit.getText();
      %last.newValuePeriodVarianceMS = PE_AFXZodiacEditor-->PEE_periodVarianceMS_textEdit.getText();
   }
   else
   {
      %action = ParticleEditor.createUndo(ActionUpdateActiveEmitterAmountFields, "Update Active Emitter");
      %action.emitter = %emitter;
      %action.isSlider = %isSlider;
      %action.onMouseUp = %onMouseUp;
      
      %action.newValueEjectionPeriodMS = PE_AFXZodiacEditor-->PEE_ejectionPeriodMS_textEdit.getText();
      %action.oldValueEjectionPeriodMS = %emitter.ejectionPeriodMS;
      
      %action.newValuePeriodVarianceMS = PE_AFXZodiacEditor-->PEE_periodVarianceMS_textEdit.getText();
      %action.oldValuePeriodVarianceMS = %emitter.periodVarianceMS;
      
      ParticleEditor.submitUndo( %action );
   }
   
   // Set the values on the current emitter.
   
   %emitter.ejectionPeriodMS = PE_AFXZodiacEditor-->PEE_ejectionPeriodMS_textEdit.getText();
   %emitter.periodVarianceMS = PE_AFXZodiacEditor-->PEE_periodVarianceMS_textEdit.getText();
   %emitter.reload();
}

