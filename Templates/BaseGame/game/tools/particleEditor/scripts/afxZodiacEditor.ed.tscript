//---------------------------------------------------------------------------------------------

function PE_AFXZodiacEditor::updateParticlesFields( %this )
{
   %particles = "";
   for( %i = 1; %i < 5; %i ++ )
   {
      %emitterParticle = "PEE_EmitterParticle" @ %i;
      %popup = %emitterParticle-->PopUpMenu;
      %text = %popup.getText();
      
      if( %text $= "" || %text $= "None" )
         continue;
         
      if( %particles $= "" )
         %particles = %text;
      else
         %particles = %particles SPC %text;
   }
   
   %changedEditParticle = 1;
   %currParticle = PE_ParticleEditor.currParticle.getName();

   foreach$( %particleName in %particles )
   {
      if( %particleName $= %currParticle )
      {
         %changedEditParticle = 0; 
         break;
      }
   }
   
   // True only if the currently edited particle has not been found and the 
   // ParticleEditor is dirty.
   
   if( %changedEditParticle && PE_ParticleEditor.dirty )
   {
      toolsMessageBoxYesNoCancel("Save Particle Changes?", 
         "Do you wish to save the changes made to the <br>current particle before changing the particle?", 
         "PE_ParticleEditor.saveParticle( " @ PE_ParticleEditor.currParticle.getName() @ " ); PE_AFXZodiacEditor.updateEmitter( \"particles\"," @ %particles @ ");", 
         "PE_ParticleEditor.saveParticleDialogDontSave( " @ PE_ParticleEditor.currParticle.getName() @ " ); PE_AFXZodiacEditor.updateEmitter( \"particles\"," @ %particles @ ");", 
         "PE_AFXZodiacEditor.guiSync();" );
   }
   else
   {
      PE_AFXZodiacEditor.updateEmitter( "particles", %particles );
   }
}

//---------------------------------------------------------------------------------------------

function PE_AFXZodiacEditor::onNewEmitter( %this )
{
   if(    isObject( PE_AFXZodiacEditor.currEmitter )
       && PE_AFXZodiacEditor.currEmitter $= PEE_EmitterSelector.getSelected() )
      return;
      
   //FIXME: disregards particle tab dirty state
   
   if( PE_AFXZodiacEditor.dirty )
   {   
      
      if( PE_ParticleEditor.dirty )
      {         
         toolsMessageBoxYesNo("Save Existing Particle?", 
            "Do you want to save changes to <br><br>" @ PE_ParticleEditor.currParticle.getName(), 
            "PE_ParticleEditor.saveParticle(" @ PE_ParticleEditor.currParticle @ ");"
         );
      }
            
      %savedEmitter = PE_AFXZodiacEditor.currEmitter;
      toolsMessageBoxYesNoCancel("Save Existing Emitter?", 
         "Do you want to save changes to <br><br>" @ %savedEmitter.getName(), 
         "PE_AFXZodiacEditor.saveEmitter(" @ %savedEmitter@ "); PE_AFXZodiacEditor.loadNewEmitter();", 
         "PE_AFXZodiacEditor.saveEmitterDialogDontSave(" @ %savedEmitter @ "); PE_AFXZodiacEditor.loadNewEmitter();"
      );
      

   }
   else
   {
      PE_AFXZodiacEditor.loadNewEmitter();
   }
}

//---------------------------------------------------------------------------------------------

function PE_AFXZodiacEditor::loadNewEmitter( %this, %emitter )
{
   if( isObject( %emitter ) )
      %current = %emitter.getId();
   else
      %current = PEE_EmitterSelector.getSelected();
   
   PE_AFXZodiacEditor.currEmitter = %current;
   PE_AFXZodiacEditor_NotDirtyEmitter.assignFieldsFrom( %current );
   PE_AFXZodiacEditor_NotDirtyEmitter.originalName = %current.name;
   
   PE_AFXZodiacEditor.guiSync();
   PE_AFXZodiacEditor.setNotDirty();
      
   PE_ParticleEditor.loadNewParticle( getWord( %current.particles, 0 ) );
   
   ParticleEditor.updateEmitterNode();
   
   PE_AFXZodiacEditor-->PEE_infiniteLoop.setStateOn( %current.lifetimeMS == 0 );
}
   
//---------------------------------------------------------------------------------------------

function PE_AFXZodiacEditor::setDirty( %this )
{
   PE_AFXZodiacEditor.text = "Zodiac *";
   PE_AFXZodiacEditor.dirty = true;
   
   %emitter = PE_AFXZodiacEditor.currEmitter;
   %filename = %emitter.getFilename();
   %editorFilename = "tools/particleEditor/particleEmitterEditor.ed." @ $TorqueScriptFileExtension;
   
   if( %filename $= "" || %filename $= %editorFilename )
      PE_EmitterSaver.setDirty( %emitter, $PE_AFXZodiacEditor_DEFAULT_FILENAME );
   else
      PE_EmitterSaver.setDirty( %emitter );
}

//---------------------------------------------------------------------------------------------

function PE_AFXZodiacEditor::setNotDirty( %this )
{   
   PE_AFXZodiacEditor.text = "Zodiac";
   PE_AFXZodiacEditor.dirty = false;
   
   PE_EmitterSaver.clearAll();
}

//---------------------------------------------------------------------------------------------

// Create Functionality
function PE_AFXZodiacEditor::showNewDialog( %this )
{
   //FIXME: disregards particle tab dirty state

   // Open a dialog if the current emitter is dirty.
   
   if( PE_ParticleEditor.dirty )
   {         
      toolsMessageBoxYesNo("Save Existing Particle?", 
         "Do you want to save changes to <br><br>" @ PE_ParticleEditor.currParticle.getName(), 
         "PE_ParticleEditor.saveParticle(" @ PE_ParticleEditor.currParticle @ ");"
      );
   }   
   
   if( PE_AFXZodiacEditor.dirty )
   {
      toolsMessageBoxYesNoCancel("Save Emitter Changes?", 
         "Do you wish to save the changes made to the <br>current emitter before changing the emitter?", 
         "PE_AFXZodiacEditor.saveEmitter( " @ PE_AFXZodiacEditor.currEmitter.getName() @ " ); PE_AFXZodiacEditor.createEmitter();", 
         "PE_AFXZodiacEditor.saveEmitterDialogDontSave( " @ PE_AFXZodiacEditor.currEmitter.getName() @ " ); PE_AFXZodiacEditor.createEmitter();"
      );
   }
   else
   {
      PE_AFXZodiacEditor.createEmitter();
   }
}

//---------------------------------------------------------------------------------------------

function PE_AFXZodiacEditor::createEmitter( %this )
{
   AssetBrowser_SelectModule.showDialog("PE_AFXZodiacEditor.pickedNewEmitterTargetModule");
   AssetBrowser_SelectModuleWindow.selectWindow();
}

function PE_AFXZodiacEditor::pickedNewEmitterTargetModule( %this, %module )
{
   %moduleDef = ModuleDatabase.findModule(%module);
   PE_AFXZodiacEditor.targetModule = %module;
   $PE_AFXZodiacEditor_DEFAULT_FILENAME = %moduleDef.ModulePath @ "/scripts/managedData/managedParticleEmitterData." @ $TorqueScriptFileExtension;
   
   if(!isDirectory(filePath($PE_AFXZodiacEditor_DEFAULT_FILENAME)))
   {
      AssetBrowser.dirHandler.createFolder(filePath($PE_AFXZodiacEditor_DEFAULT_FILENAME));
   }
   
   // Create a new emitter.
   %emitter = getUniqueName( "newEmitter" );
   datablock ParticleEmitterData( %emitter : DefaultEmitter )
   {
   };
   
   // Submit undo.
   
   %action = ParticleEditor.createUndo( ActionCreateNewEmitter, "Create New Emitter" );
   %action.prevEmitter = PE_AFXZodiacEditor.currEmitter;
   %action.emitter = %emitter.getId();
   %action.emitterName = %emitter;

   ParticleEditor.submitUndo( %action );

   // Execute action.
   
   %action.redo();
   
   %this-->PopupMenu.setText(%emitter.getName());
   %this-->inspector.inspect(%emitter);
   
   PE_ParticleEditor.createParticle(false);
}

//---------------------------------------------------------------------------------------------

function PE_AFXZodiacEditor::showDeleteDialog( %this )
{
   if( PE_AFXZodiacEditor.currEmitter.getName() $= "DefaultEmitter" )
   {
      toolsMessageBoxOK( "Error", "Cannot delete DefaultEmitter");
      return;
   }
   
   if( isObject( PE_AFXZodiacEditor.currEmitter ) )
   {
      toolsMessageBoxYesNoCancel("Delete Emitter?", 
         "Are you sure you want to delete<br><br>" @ PE_AFXZodiacEditor.currEmitter.getName() @ "<br><br> Emitter deletion won't take affect until the level is exited.", 
         "PE_AFXZodiacEditor.saveEmitterDialogDontSave( " @ PE_AFXZodiacEditor.currEmitter.getName() @ " ); PE_AFXZodiacEditor.deleteEmitter();"
      );
   }
}

//---------------------------------------------------------------------------------------------

function PE_AFXZodiacEditor::deleteEmitter( %this )
{  
   %emitter = PE_AFXZodiacEditor.currEmitter;
   
   // Create undo.
   
   %action = ParticleEditor.createUndo( ActionDeleteEmitter, "Delete Emitter" );
   %action.emitter = %emitter;
   %action.emitterFname = %emitter.getFilename();

   ParticleEditor.submitUndo( %action );
   
   // Execute action.

   %action.redo();
}

//---------------------------------------------------------------------------------------------

function PE_AFXZodiacEditor::saveEmitter( %this, %emitter )
{   
   if ( %emitter $= "" )
      %newName = PEE_EmitterSelector_Control->TextEdit.getText();
   else
      %newName = %emitter.getName();
   
   PE_AFXZodiacEditor.currEmitter.setName( %newName );
   PE_AFXZodiacEditor_NotDirtyEmitter.assignFieldsFrom( %emitter );
   PE_AFXZodiacEditor_NotDirtyEmitter.originalName = %newName;
   
   PE_EmitterSaver.saveDirty(); 
   
   PE_AFXZodiacEditor.currEmitter = %newName.getId();
   PE_AFXZodiacEditor.setNotDirty();
   
   ParticleEditor.createParticleList(); 
}

//---------------------------------------------------------------------------------------------

function PE_AFXZodiacEditor::saveEmitterDialogDontSave( %this, %emitter)
{  
   %emitter.setName( PE_AFXZodiacEditor_NotDirtyEmitter.originalName );
   %emitter.assignFieldsFrom( PE_AFXZodiacEditor_NotDirtyEmitter );
   PE_AFXZodiacEditor.setNotDirty();
}

//=============================================================================================
//    PEE_EmitterSelector_Control.
//=============================================================================================

//---------------------------------------------------------------------------------------------

function PEE_EmitterSelector_Control::onRenameItem( %this )
{
   Parent::onRenameItem( %this );
   
   //FIXME: need to check for validity of name and name clashes

   PE_AFXZodiacEditor.setDirty();
   
   // Resort menu.
   
   %this-->PopupMenu.sort();
}