function GuiInspectorGroup::buildBakeCompositeButtonField(%this, %fieldName, %fieldLabel, %fieldDesc, %fieldDefaultVal, %fieldDataVals, %callbackName, %ownerObj)
{
   %fieldWidth = %this-->stack.extent.x;
   %container = new GuiControl() {
      canSaveDynamicFields = "0";
      Profile = "EditorContainerProfile";
      HorizSizing = "Width";
      VertSizing = "bottom";
      Position = "0 0";
      Extent = %fieldWidth SPC 20;
      MinExtent = "8 2";
      canSave = "0";
      Visible = "1";
      hovertime = "100";
      tooltip = "";// %tooltip;
      tooltipProfile = "EditorToolTipProfile";
      
      new GuiButtonCtrl() {
         canSaveDynamicFields = "0";
         Profile = "ToolsGuiButtonProfile";
         HorizSizing = "width";
         VertSizing = "bottom";
         Position = "16 3";
         Extent = %fieldWidth SPC 18;
         MinExtent = "8 2";
         canSave = "0";
         Visible = "1";
         hovertime = "100";
         tooltip = ""; //%tooltip;
         tooltipProfile = "EditorToolTipProfile";
         text = "Bake Composite Map";
         maxLength = "1024";
         command = "MaterialEditorGui.saveCompositeMap();";
      };
   };
   
   %this-->stack.add(%container);
}